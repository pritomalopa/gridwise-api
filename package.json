{
  "name": "gridwise-api",
  "version": "1.0.0",
  "description": "LLM-assisted smart campus energy optimization API for BUP CSE Fest 2026 preliminary (GridWise).",
  "main": "dist/src/server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:frontend": "cd frontend && npm ci && npm run build",
    "build:all": "npm run build && npm run build:frontend",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "test:optimizer": "tsx scripts/check-optimizer.ts",
    "test:samples": "tsx scripts/run-public-samples.ts",
    "dump:samples": "tsx scripts/run-public-samples.ts --dump",
    "test:edge": "tsx scripts/check-edge-cases.ts",
    "test": "npm run test:optimizer && npm run test:edge"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "javascript-lp-solver": "^1.0.3",
    "mongoose": "^8.9.5",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.11.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}