# ---------------------------------------------------------------------------
# GridWise API — environment variables
# Copy to .env and fill in a real key. NEVER commit the filled-in .env.
# ---------------------------------------------------------------------------

# Port the HTTP service binds to (0.0.0.0:PORT). Render/Railway inject this.
PORT=8080

# Which model provider interprets the operator notes: "anthropic" or "openai".
LLM_PROVIDER=anthropic

# Model identifier.
#   anthropic: claude-sonnet-5 (default, best accuracy)
#              claude-haiku-4-5-20251001 (fastest, use if p95 latency is tight)
#   openai:    gpt-4o-mini / gpt-4o
LLM_MODEL=claude-sonnet-5

# Exactly one of these is required, matching LLM_PROVIDER.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: override the Anthropic base URL (gateway/proxy). Leave blank normally.
# ANTHROPIC_BASE_URL=

# Optional tuning. Defaults shown.
LLM_TIMEOUT_MS=12000
LLM_MAX_RETRIES=1
LLM_CACHE=true
LLM_CACHE_SIZE=500

# --- MERN Dashboard persistence (all optional — leave empty for in-memory judge-safe mode) ---
# MERN's M: MongoDB for run history. If set, history is persisted to MongoDB in background.
# Example: mongodb+srv://user:pass@cluster.mongodb.net/gridwise
MONGODB_URI=
# MONGO_URI is also accepted as alias
# Alternative: PostgreSQL (also optional). If MONGODB_URI is empty, falls back to Postgres.
# Example: postgres://user:pass@host:5432/gridwise  or  postgresql://...
DATABASE_URL=
# POSTGRES_URL alias is also accepted

# Frontend: when running Vite dev server separately, point it at the API.
# Leave empty in production — frontend is served from the same origin.
# VITE_API_BASE=http://localhost:8080
