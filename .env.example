# GridWise API — secrets
# Copy to .env and fill in (never commit .env)
PORT=3000

# --- LLM provider (at least ONE recommended for judging) ---
# Option A: OpenAI-compatible (OpenAI / Groq / Together / OpenRouter ...)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.1-8b-instant

# Option B: Google Gemini (free tier available)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Option C: Local Ollama (no key needed if running locally)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# Behavior
LLM_TIMEOUT_MS=9000
LLM_MAX_RETRIES=1
