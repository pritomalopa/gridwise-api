# GridWise API — environment template
# Usage: copy to .env, then fill ONLY the key(s) for your provider.
# Never commit .env (it holds secrets). Non-secret defaults below already work as-is.

PORT=3000

# --- LLM provider: Groq (recommended, free tier, fast) ---
# Get key: https://console.groq.com -> API Keys -> Create
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.1-8b-instant

# --- Backup provider: Google Gemini (free tier) ---
# Get key: https://aistudio.google.com -> Get API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Local provider: Ollama (no key needed, only if running locally) ---
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b

# --- Behavior ---
LLM_TIMEOUT_MS=9000
LLM_MAX_RETRIES=1
