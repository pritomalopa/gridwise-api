# GridWise API — environment template. Copy to .env and fill in. Never commit .env.
PORT=8000

# --- Primary LLM: Groq (recommended, free tier, fast) ---
# Get key: https://console.groq.com -> API Keys -> Create
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3-32b

# --- Backstop LLM: Cerebras (high rate limits, optional but recommended) ---
# Get key: https://cloud.cerebras.ai -> API Keys
CEREBRAS_API_KEY=
CEREBRAS_MODELS=qwen-3.8-27b,gpt-oss-120b

# --- Legacy names (kept working so the existing Render env needs no change) ---
# OPENAI_* is OpenAI-compatible; on Render it points at Groq.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.1-8b-instant
# Gemini backup
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Local Ollama (no key)
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b

# --- Behavior ---
LLM_TIMEOUT_S=8
LLM_TOTAL_BUDGET_S=18
LLM_MAX_OUTPUT_TOKENS=600
WEB_CONCURRENCY=1
